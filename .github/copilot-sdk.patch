+
+pub async fn call_with_stream_events(
+    base_url: &str,
+    model: &str,
+    provider: &str,
+    api_key: &str,
+    messages: &[serde_json::Value],
+    options: &crate::tura_llm::CallOptions,
+    stream_events: Option<crate::tura_llm::ProviderStreamEventSink>,
