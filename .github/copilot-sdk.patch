+        return crate::llm::providers::github_copilot::call_with_stream_events(
+            base_url,
+            model,
+            api_key,
+            messages,
+            options,
+            stream_events,
+        )
+        .await;
+    }
+    chat::call_with_stream_events(
+        base_url,
+        model,
+        provider,
+        api_key,
+        messages,
+        options,
+        stream_events,
+    )
